import cv2
import numpy as np

# Carregar imagem
img = cv2.imread("laranjas.jpg")

# Converter imagem para HSV
hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

# Faixa de cor laranja (pode ajustar se necessário)
laranja_baixo = np.array([5, 100, 100])
laranja_alto = np.array([20, 255, 255])

# Cria máscara para encontrar regiões laranjas
mascara = cv2.inRange(hsv, laranja_baixo, laranja_alto)

# Encontra contornos (cada contorno pode ser uma laranja)
contornos, _ = cv2.findContours(mascara, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

for c in contornos:
    # Pegando o círculo mínimo que envolve o contorno
    (x, y), raio = cv2.minEnclosingCircle(c)

    # Evitar falsos positivos (ruídos muito pequenos)
    if raio > 10:
        # Desenhar círculo ao redor da laranja
        cv2.circle(img, (int(x), int(y)), int(raio), (0, 255, 0), 2)

        # Marcar o centro exato da laranja
        cv2.circle(img, (int(x), int(y)), 4, (255, 0, 0), -1)

        # Mostrar coordenadas na tela
        texto = f"({int(x)}, {int(y)})"
        cv2.putText(img, texto, (int(x) + 5, int(y) - 5),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)

# Mostrar imagem final
cv2.imshow("Laranjas detectadas", img)
cv2.waitKey(0)
cv2.destroyAllWindows()
