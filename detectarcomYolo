from ultralytics import YOLO
import cv2

# Carrega modelo YOLO treinado para frutas
modelo = YOLO("yolov8n.pt")  # ou um modelo treinado só para laranjas

img = cv2.imread("laranjas.jpg")

# Detectar objetos
resultados = modelo(img)

for r in resultados:
    for box in r.boxes:
        x1, y1, x2, y2 = box.xyxy[0]
        cx = int((x1 + x2) / 2)
        cy = int((y1 + y2) / 2)

        # Desenha caixa e marca centro
        cv2.rectangle(img, (int(x1), int(y1)), (int(x2), int(y2)), (0,255,0), 2)
        cv2.circle(img, (cx, cy), 4, (255,0,0), -1)
        cv2.putText(img, f"({cx}, {cy})", (cx+5, cy-5), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 2)

cv2.imshow("Deteccao", img)
cv2.waitKey(0)
cv2.destroyAllWindows()
